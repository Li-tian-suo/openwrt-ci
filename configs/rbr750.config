# 关键：指定使用开发版配置，而非稳定版
CONFIG_VERSION_CODE=""
CONFIG_VERSION_REPO="https://downloads.openwrt.org/snapshots/trunk/qualcommax/ipq807x"

# 平台和设备设置
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq807x=y
CONFIG_TARGET_DEVICE_qualcommax_ipq807x_DEVICE_netgear_rbr750=y

# 启用 NSS 固件（针对 IPQ8074）
CONFIG_NSS_FIRMWARE_VERSION_11_4=y
CONFIG_PACKAGE_nss-firmware-ipq8074=y
